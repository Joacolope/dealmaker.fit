{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/booking-page", "destination": "/agenda", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/presentacion",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(webp|png|svg|jpg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/recurso.js": { "maxDuration": 20 },
    "api/reintentar-meta.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/reintentar-meta", "schedule": "0 12 * * *" }
  ]
}
